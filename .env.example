# Server-only Supabase PostgreSQL Session Pooler connection.
# Never expose this value through VITE_* variables or client-side code.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Optional. Notifications are sent only when enabled for a report or schedule.
# SLACK_REPORT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional override for a provider-specific root certificate.
# Supabase's Root 2021 CA is bundled with the server.
# PGSSLROOTCERT=/absolute/path/to/provider-root-ca.crt

PORT=3000
